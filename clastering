# --- IMPORTACIONES ---
import pandas as pd
import numpy as np                        
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score
import matplotlib.pyplot as plt

# --- CARGA DE DATOS ---
df = pd.read_csv('../DataSet/train.csv')

# --- SELECCIÓN DE COLUMNAS ---
X = df[['Sales']]
#Y = df[['Discount']]  # Definida pero no usada en el clustering; eliminada

# --- NORMALIZACIÓN ---
# StandardScaler centra 
# los datos (media=0, desviación=1)
# Necesario para que KMeans no se vea afectado por la magnitud de las variables
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# --- DETECCIÓN DE OUTLIERS CON IQR ---
# Valores fuera de [Q1 - 1.5·IQR, Q3 + 1.5·IQR] se consideran outliers
Q1 = np.percentile(X_scaled, 25, axis=0)
Q3 = np.percentile(X_scaled, 75, axis=0)
IQR = Q3 - Q1

outliers_condition = (
    (X_scaled < (Q1 - 1.5 * IQR)) | (X_scaled > (Q3 + 1.5 * IQR))
)

# --- TRATAMIENTO DE OUTLIERS (CLIPPING) ---
# Los valores fuera del rango se recortan al límite más cercano
X_scaled_outliers_handled = np.copy(X_scaled)

for i in range(X_scaled.shape[1]):
    X_scaled_outliers_handled[:, i] = np.clip(
        X_scaled_outliers_handled[:, i],
        Q1[i] - 1.5 * IQR[i],   
        Q3[i] + 1.5 * IQR[i]   
    )

# --- INICIALIZACIÓN DE LISTAS ---
inertia = []
sil_scores = []

# --- MÉTODO DEL CODO ---
# Calcula la inercia para k = 1 a 10
# El "codo" es el punto donde la inercia deja de bajar bruscamente → k óptimo
for k in range(1, 11):
    kmeans = KMeans(n_clusters=k, random_state=42)
    kmeans.fit(X_scaled_outliers_handled)
    inertia.append(kmeans.inertia_)

# --- SILHOUETTE SCORE ---
# Calcula la puntuación silhouette para k = 2 a 10
# Con k=1 no tiene sentido calcularlo (no hay comparación entre grupos)
# Valores cercanos a 1 = clústeres bien definidos y separados
for k in range(2, 11):
    kmeans = KMeans(n_clusters=k, random_state=42)
    kmeans.fit(X_scaled_outliers_handled)
    sil = silhouette_score(X_scaled_outliers_handled, kmeans.labels_)
    sil_scores.append(sil)

# --- GRÁFICA DEL CODO ---
plt.figure(figsize=(8, 6))
plt.plot(range(1, 11), inertia, marker='o')
plt.title('Método del codo para elegir el número de clústeres')
plt.xlabel('Número de clústeres (k)')
plt.ylabel('Inercia')
plt.tight_layout()
plt.show()

# --- GRÁFICA SILHOUETTE ---
plt.figure(figsize=(8, 6))
plt.plot(range(2, 11), sil_scores, marker='o', color='orange')
plt.title('Puntuación Silhouette por número de clústeres')
plt.xlabel('Número de clústeres (k)')
plt.ylabel('Silhouette Score')
plt.tight_layout()
plt.show()
